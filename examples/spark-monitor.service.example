# Replace APP_DIRECTORY with the absolute checkout directory before installing.
[Unit]
Description=Spark Monitor live resource dashboard
After=network.target

[Service]
ExecStart=/usr/bin/python3 /APP_DIRECTORY/server.py --host 127.0.0.1 --port 8765 --interval 1 --ollama http://127.0.0.1:11434 --power-max 140
Restart=on-failure
Nice=10

[Install]
WantedBy=default.target
